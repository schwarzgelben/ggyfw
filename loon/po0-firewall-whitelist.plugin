#!name=GGY 咕咕云防火墙自动加白
#!desc=调用咕咕云 (GGY) 防火墙白名单链接将本机当前出口 IP 自动加入安全组白名单。支持多 token（英文逗号分割），network-changed 事件与每 10 分钟 cron 自动触发。
#!author=reallinzc
#!homepage=https://github.com/schwarzgelben/ggyfw
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Panel.png

[Argument]
tokens = input,"",tag=API tokens,desc=咕咕云防火墙白名单 token 或完整分享链接；多台机器用英文逗号分割

[Rule]
DOMAIN,www.guguyun.com,DIRECT

[Script]
cron "*/10 * * * *" script-path=https://raw.githubusercontent.com/schwarzgelben/ggyfw/main/scripts/po0-firewall-whitelist.js, timeout=60, tag=ggy-fw-cron, argument=[{tokens}]
network-changed script-path=https://raw.githubusercontent.com/schwarzgelben/ggyfw/main/scripts/po0-firewall-whitelist.js, timeout=60, tag=ggy-fw-event, argument=[{tokens}]

