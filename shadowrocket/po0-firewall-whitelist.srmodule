#!name=GGY 咕咕云防火墙自动加白
#!desc=安装后：配置 → 模块 → 长按本模块 → 编辑纯文本，把下方两行 argument 中的 tokens= 替换成加白 token 或链接（支持 token@0 或 token@rotate），traffic_tokens= 替换成流量查询 token 或链接。
#!author=reallinzc
#!homepage=https://github.com/schwarzgelben/ggyfw

[Rule]
DOMAIN,www.guguyun.com,DIRECT

[Script]
ggy-fw-cron = type=cron,cronexpr="*/10 * * * *",script-path=https://raw.githubusercontent.com/schwarzgelben/ggyfw/main/scripts/po0-firewall-whitelist.js?v=20261111d,timeout=60,argument="tokens=在此填入加白token&traffic_tokens=在此填入流量token"
ggy-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/schwarzgelben/ggyfw/main/scripts/po0-firewall-whitelist.js?v=20261111d,timeout=60,argument="tokens=在此填入加白token&traffic_tokens=在此填入流量token"
