name: GGY 咕咕云防火墙自动加白
desc: |-
  调用咕咕云 (GGY) 防火墙白名单链接将出口 IP 自动加入安全组，并展示实时流量。
  支持固定槽位 (@0~@4)、环形轮换写入、定时自动加白与磁贴手动刷新。
  安装后把下方两处 argument 的 tokens= 后面填上咕咕云 token 或完整分享链接（支持 token@0 或 token@rotate）。
category: 咕咕云
icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Panel.png

rules:
  - DOMAIN,www.guguyun.com,DIRECT

http:
  mitm: []

script-providers:
  ggy-fw:
    url: https://raw.githubusercontent.com/schwarzgelben/ggyfw/main/scripts/po0-firewall-whitelist.js?v=20261111d
    interval: 86400

cron:
  script:
    - name: ggy-fw
      cron: '*/10 * * * *'
      timeout: 60
      argument: tokens=&traffic_tokens=

tiles:
  - name: ggy-fw
    interval: 300
    title: 咕咕云防火墙加白
    content: 点击刷新
    argument: tokens=&traffic_tokens=
