#!name=GGY 咕咕云防火墙自动加白
#!desc=调用咕咕云 (GGY) 防火墙白名单链接将本机当前出口 IP 自动加入安全组白名单。支持多 token 或分享链接（逗号分割），支持 network-changed 网络变化与每 10 分钟定时自动加白，附带 Surge 面板手动刷新。
#!category=咕咕云
#!author=reallinzc
#!arguments=tokens:""
#!arguments-desc=tokens: 咕咕云防火墙白名单 token 或完整分享链接，多台机器用英文逗号 , 分割

[Rule]
# 加白请求必须直连，确保 API 识别的是本机真实出口 IP 而不是代理出口
DOMAIN,www.guguyun.com,DIRECT

[Script]
ggy-fw-cron = type=cron,cronexp="*/10 * * * *",script-path=https://raw.githubusercontent.com/schwarzgelben/ggyfw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
ggy-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/schwarzgelben/ggyfw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
ggy-fw-panel = type=generic,script-path=https://raw.githubusercontent.com/schwarzgelben/ggyfw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"

[Panel]
ggy-fw = script-name=ggy-fw-panel,title=咕咕云防火墙加白,content=点击刷新,update-interval=300

