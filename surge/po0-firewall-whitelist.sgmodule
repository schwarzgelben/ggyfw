#!name=GGY 咕咕云防火墙自动加白
#!desc=调用咕咕云 (GGY) 防火墙白名单链接将本机出口 IP 自动加入安全组。支持手机识别 /24 放行、同网段智能节流防占坑、2分钟极速自愈探测与面板手动刷新。
#!category=咕咕云
#!author=reallinzc
#!arguments=tokens:"",skip_wifi:"",ua:"",interval:""
#!arguments-desc=tokens: 咕咕云防火墙白名单 token 或完整分享链接，多台机器用英文逗号分割\nskip_wifi: 可选，信任的家庭 Wi-Fi 名称（SSID，多个逗号分割），连入时自动跳过上报以保留轮换槽位配额\nua: 可选，UA 模拟模式。mobile（默认，手机 UA，固定槽位可放行 /24 网段）；pc（电脑 UA，放行 /32 单IP）\ninterval: 可选，心跳保活强制重新上报间隔（分钟，默认 10）

[Rule]
# 加白请求与公网出口 IP 探测必须直连，确保识别的是本机真实出口 IP 而不是代理出口
DOMAIN,www.guguyun.com,DIRECT
DOMAIN-SUFFIX,3322.net,DIRECT
DOMAIN-SUFFIX,ip.sb,DIRECT
DOMAIN,1.1.1.1,DIRECT

[Script]
ggy-fw-cron = type=cron,cronexp="*/2 * * * *",script-path=https://raw.githubusercontent.com/schwarzgelben/ggyfw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&skip_wifi={{{skip_wifi}}}&ua={{{ua}}}&interval={{{interval}}}"
ggy-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/schwarzgelben/ggyfw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&skip_wifi={{{skip_wifi}}}&ua={{{ua}}}&interval={{{interval}}}"
ggy-fw-panel = type=generic,script-path=https://raw.githubusercontent.com/schwarzgelben/ggyfw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&skip_wifi={{{skip_wifi}}}&ua={{{ua}}}&interval={{{interval}}}"

[Panel]
ggy-fw = script-name=ggy-fw-panel,title=咕咕云防火墙加白,content=点击刷新,update-interval=120
